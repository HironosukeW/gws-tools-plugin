#!/bin/sh
# gws ラッパー（Git Bash / macOS / Linux 用）
# プラグイン設定に入力された OAuth クライアント情報を gws が読む環境変数へ渡してから、
# 同じディレクトリの本体を呼び出す。これにより client_secret.json の配置が不要になる。
set -e

dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if [ -n "${CLAUDE_PLUGIN_OPTION_CLIENT_ID:-}" ]; then
  GOOGLE_WORKSPACE_CLI_CLIENT_ID="$CLAUDE_PLUGIN_OPTION_CLIENT_ID"
  export GOOGLE_WORKSPACE_CLI_CLIENT_ID
fi

if [ -n "${CLAUDE_PLUGIN_OPTION_CLIENT_SECRET:-}" ]; then
  GOOGLE_WORKSPACE_CLI_CLIENT_SECRET="$CLAUDE_PLUGIN_OPTION_CLIENT_SECRET"
  export GOOGLE_WORKSPACE_CLI_CLIENT_SECRET
fi

if [ -x "$dir/gws-bin.exe" ]; then
  exec "$dir/gws-bin.exe" "$@"
fi

if [ -x "$dir/gws-bin" ]; then
  exec "$dir/gws-bin" "$@"
fi

echo "gws の本体が見つかりません。$dir に gws-bin.exe（Windows）または gws-bin を配置してください。" >&2
exit 127
